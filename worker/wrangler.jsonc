{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "e2t-translate-api",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "ALLOWED_ORIGIN": "https://jayasuryamahadevan.github.io"
  },
  "ratelimits": [
    { "name": "TRANSLATE_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
}
